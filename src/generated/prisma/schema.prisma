// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  M
  F
}

model Members {
  id                Int                 @id @default(autoincrement())
  email             String              @unique(map: "email") @db.VarChar(30)
  name              String              @db.VarChar(10)
  gender            Gender
  birth             DateTime            @map("birthday") @db.Date
  address           String              @db.VarChar(30)
  phoneNumber       String              @map("phone_no") @db.VarChar(10)
  membersFoodTypes  MembersFoodType[]
  acceptedMissions  AcceptedMissions[]
  completedMissions CompletedMissions[]
  review            Review[]

  @@map("members")
}

model MembersFoodType {
  id         Int @id @default(autoincrement())
  userId     Int @map("user_id")
  foodTypeId Int @map("food_type_id")

  members  Members  @relation(fields: [userId], references: [id])
  foodType FoodType @relation(fields: [foodTypeId], references: [id])

  @@index([userId], map: "user_id")
  @@index([foodTypeId], map: "food_type_id")
  @@map("members_food_type")
}

model FoodType {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(10)
  storeTypeName    String            @map("store_type_name") @db.VarChar(10)
  membersFoodTypes MembersFoodType[]
  store            Store[]

  @@map("food_type")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  storeId    Int      @map("store_id")
  uploadedAt DateTime @map("uploaded_at")
  star       Float
  contents   String   @db.Text

  members Members @relation(fields: [userId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@map("review")
}

model Store {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(30)
  foodTypeId Int    @map("food_type_id")
  address    String @db.VarChar(30)
  openTime   String @map("open_time") @db.VarChar(8)
  closeTime  String @map("close_time") @db.VarChar(8)
  locationId Int    @map("location_id")

  review      Review[]
  storeStatus StoreStatus[]
  missions    Missions[]
  foodType    FoodType      @relation(fields: [foodTypeId], references: [id])
  locations   Locations     @relation(fields: [locationId], references: [id])

  @@map("store")
}

model Locations {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(10)
  store    Store[]
  missions Missions[]

  @@map("locations")
}

model StoreStatus {
  id           Int   @id @default(autoincrement())
  storeId      Int   @map("store_id")
  reviewsCount Int   @map("reviews_count")
  starTotal    Float @map("star_total")
  store        Store @relation(fields: [storeId], references: [id])

  @@map("store_status")
}

model Missions {
  id         Int       @id @default(autoincrement())
  storeId    Int       @map("store_id")
  goal       Int
  rewards    Int
  expireDate DateTime  @map("expire_date")
  locationId Int       @map("location_id")
  store      Store     @relation(fields: [storeId], references: [id])
  locations  Locations @relation(fields: [locationId], references: [id])

  acceptedMissions  AcceptedMissions[]
  completedMissions CompletedMissions[]

  @@map("missions")
}

model AcceptedMissions {
  id               Int       @id @default(autoincrement())
  missionId        Int       @map("mission_id")
  userId           Int       @map("user_id")
  verificationCode String    @map("verification_code") @db.VarChar(9)
  completedAt      DateTime? @map("completed_at")

  missions Missions @relation(fields: [missionId], references: [id])
  members  Members  @relation(fields: [userId], references: [id])

  @@map("accepted_missions")
}

model CompletedMissions {
  id          Int      @id @default(autoincrement())
  missionId   Int      @map("mission_id")
  userId      Int      @map("user_id")
  completedAt DateTime @map("completed_at")

  missions Missions @relation(fields: [missionId], references: [id])
  members  Members  @relation(fields: [userId], references: [id])

  @@map("completed_missions")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.VarChar(512)
  expiresAt DateTime @map("expires_at")

  @@map("session")
}
